<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!--
    VFEP's Aerial shoulders and helmet carry VFEP_PowerJumpRange offsets (+5 and +10) that only
    the Aerial Power Jump reads. This mirrors them onto SCWC_BreachJumpRange, so at the foundry
    Aerial jump hardware extends the Breach Jump too: 35 with both, still under Aerial's own
    40. No reverse patch: breaching arms and a respirator are not jump hardware. The xpaths
    match the leaf these defs declare directly, so the patch is independent of VFEP's bases.
  -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/VFEPirates.WarcasketDef[defName = "VFEP_WarcasketShoulders_Aerial"]/equippedStatOffsets</xpath>
    <value>
      <SCWC_BreachJumpRange>5</SCWC_BreachJumpRange>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/VFEPirates.WarcasketDef[defName = "VFEP_WarcasketHelmet_Aerial"]/equippedStatOffsets</xpath>
    <value>
      <SCWC_BreachJumpRange>10</SCWC_BreachJumpRange>
    </value>
  </Operation>
</Patch>

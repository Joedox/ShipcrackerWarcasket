<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!--
    Planet-flight exhaust for the Breach Jump (the extension's flightEffecter): VFEP's
    VFEP_PowerJumpPawnEffect (Aerial's Power Jump) child for child, on VFEP's flecks, sound and
    smoke, with two changes. positionOffset (0,0,-0.05) instead of -0.5 starts the flecks at
    the mid-back thruster outlets on our torso art rather than the feet, and the flame runs 28
    ticks instead of 14 (smoke 16 motes instead of 8) so the hop reads bigger. A copy rather
    than a patch so Aerial's own jump keeps its look.

    The three continuous sprayers are ExhaustSprayerDef: SubEffecter_ExhaustSprayer sprays
    fleckDefNorth (fleckDef raised to the PawnState layer) while the flying wearer faces north,
    so the trail draws over the wearer's back when the outlets face the camera.

    Siblings to keep in step: SCWC_BreachBurnFlame (same children, longer burn) and the VGE
    root's purple SCWC_BreachJumpAstroflame.
  -->
  <EffecterDef>
    <defName>SCWC_BreachJumpFlame</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SoundTriggered</subEffecterClass>
        <spawnLocType>OnSource</spawnLocType>
        <soundDef>VFEP_JumpLaunch</soundDef>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <spawnLocType>OnSource</spawnLocType>
        <fleckDef>ShotFlash</fleckDef>
        <scale>6</scale>
      </li>
      <li Class="ShipcrackerWarcasket.ExhaustSprayerDef">
        <subEffecterClass>ShipcrackerWarcasket.SubEffecter_ExhaustSprayer</subEffecterClass>
        <scale>0.5~0.6</scale>
        <spawnLocType>OnSource</spawnLocType>
        <positionOffset>(0,0,-0.05)</positionOffset>
        <fleckDef>VFEP_JumpFlame</fleckDef>
        <fleckDefNorth>SCWC_JumpFlameNorth</fleckDefNorth>
        <ticksBetweenMotes>1</ticksBetweenMotes>
        <maxMoteCount>28</maxMoteCount>
        <speed>4~5</speed>
        <angle>170~190</angle>
        <absoluteAngle>true</absoluteAngle>
      </li>
      <li Class="ShipcrackerWarcasket.ExhaustSprayerDef">
        <subEffecterClass>ShipcrackerWarcasket.SubEffecter_ExhaustSprayer</subEffecterClass>
        <scale>0.9~0.7</scale>
        <spawnLocType>OnSource</spawnLocType>
        <positionOffset>(0,0,-0.05)</positionOffset>
        <fleckDef>VFEP_JumpFlameGlow</fleckDef>
        <fleckDefNorth>SCWC_JumpFlameGlowNorth</fleckDefNorth>
        <ticksBetweenMotes>1</ticksBetweenMotes>
        <maxMoteCount>28</maxMoteCount>
        <speed>4~5</speed>
        <angle>160~200</angle>
        <absoluteAngle>true</absoluteAngle>
      </li>
      <li Class="ShipcrackerWarcasket.ExhaustSprayerDef">
        <subEffecterClass>ShipcrackerWarcasket.SubEffecter_ExhaustSprayer</subEffecterClass>
        <scale>0.8~1.2</scale>
        <spawnLocType>OnSource</spawnLocType>
        <positionOffset>(0,0,-0.05)</positionOffset>
        <fleckDef>VFEP_JumpSmoke</fleckDef>
        <fleckDefNorth>SCWC_JumpSmokeNorth</fleckDefNorth>
        <ticksBetweenMotes>2</ticksBetweenMotes>
        <maxMoteCount>16</maxMoteCount>
        <speed>5~6</speed>
        <angle>170~190</angle>
        <absoluteAngle>true</absoluteAngle>
      </li>
    </children>
  </EffecterDef>
</Defs>

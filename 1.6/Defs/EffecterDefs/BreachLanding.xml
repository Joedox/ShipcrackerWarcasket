<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!--
    Landing shockwave for the Breach Jump, planet and space: the explosionCenterEffecter of the
    SCWC_Breach DamageDef, fired at the blast center alongside that def's Bomb-style flash,
    smoke and cell flecks (Biotech's mech-band stun uses the same slot). Visual only; the
    sound is the explosion's.
  -->
  <EffecterDef>
    <defName>SCWC_BreachLanding</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <spawnLocType>OnSource</spawnLocType>
        <fleckDef>SCWC_BreachLandingShockwave</fleckDef>
      </li>
    </children>
  </EffecterDef>
</Defs>

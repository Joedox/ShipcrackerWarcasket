<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!--
    Space-flight exhaust for the breach burn (the extension's spaceFlightEffecter), after VFEP's
    VFEP_BlastOffEffect (Shock's Blast Off). SCWC_BreachJumpFlame (see its header) with the
    sprayers' maxMoteCount at 1000 instead of 28 and 16, so the flame burns to the landing of
    a multi-second space flight. Keep in step with it and the VGE root's purple
    SCWC_BreachBurnAstroflame.
  -->
  <EffecterDef>
    <defName>SCWC_BreachBurnFlame</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SoundTriggered</subEffecterClass>
        <spawnLocType>OnSource</spawnLocType>
        <soundDef>VFEP_JumpLaunch</soundDef>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <spawnLocType>OnSource</spawnLocType>
        <fleckDef>ShotFlash</fleckDef>
        <scale>6</scale>
      </li>
      <li Class="ShipcrackerWarcasket.ExhaustSprayerDef">
        <subEffecterClass>ShipcrackerWarcasket.SubEffecter_ExhaustSprayer</subEffecterClass>
        <scale>0.5~0.6</scale>
        <spawnLocType>OnSource</spawnLocType>
        <positionOffset>(0,0,-0.05)</positionOffset>
        <fleckDef>VFEP_JumpFlame</fleckDef>
        <fleckDefNorth>SCWC_JumpFlameNorth</fleckDefNorth>
        <ticksBetweenMotes>1</ticksBetweenMotes>
        <maxMoteCount>1000</maxMoteCount>
        <speed>4~5</speed>
        <angle>170~190</angle>
        <absoluteAngle>true</absoluteAngle>
      </li>
      <li Class="ShipcrackerWarcasket.ExhaustSprayerDef">
        <subEffecterClass>ShipcrackerWarcasket.SubEffecter_ExhaustSprayer</subEffecterClass>
        <scale>0.9~0.7</scale>
        <spawnLocType>OnSource</spawnLocType>
        <positionOffset>(0,0,-0.05)</positionOffset>
        <fleckDef>VFEP_JumpFlameGlow</fleckDef>
        <fleckDefNorth>SCWC_JumpFlameGlowNorth</fleckDefNorth>
        <ticksBetweenMotes>1</ticksBetweenMotes>
        <maxMoteCount>1000</maxMoteCount>
        <speed>4~5</speed>
        <angle>160~200</angle>
        <absoluteAngle>true</absoluteAngle>
      </li>
      <li Class="ShipcrackerWarcasket.ExhaustSprayerDef">
        <subEffecterClass>ShipcrackerWarcasket.SubEffecter_ExhaustSprayer</subEffecterClass>
        <scale>0.8~1.2</scale>
        <spawnLocType>OnSource</spawnLocType>
        <positionOffset>(0,0,-0.05)</positionOffset>
        <fleckDef>VFEP_JumpSmoke</fleckDef>
        <fleckDefNorth>SCWC_JumpSmokeNorth</fleckDefNorth>
        <ticksBetweenMotes>2</ticksBetweenMotes>
        <maxMoteCount>1000</maxMoteCount>
        <speed>5~6</speed>
        <angle>170~190</angle>
        <absoluteAngle>true</absoluteAngle>
      </li>
    </children>
  </EffecterDef>
</Defs>

<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!--
    Flight leg of Ability_BreachJump, templated from VFEP's VFEP_PowerJumpPawn. flightSpeed is
    unused: PawnFlyer_BreachJump times the flight from the wearer's VFEP_FlightSpeed (scaled
    and capped in space by the ability's extension), with flightDurationMin 0.5 s as the floor.
    PawnFlyerBase's progressCurve and heightFactor shape the planet arc only; in space the
    flyer moves in a straight line at constant speed.
  -->
  <ThingDef ParentName="PawnFlyerBase">
    <defName>SCWC_BreachJumpFlyer</defName>
    <thingClass>ShipcrackerWarcasket.PawnFlyer_BreachJump</thingClass>
    <pawnFlyer>
      <flightDurationMin>0.5</flightDurationMin>
      <flightSpeed>12</flightSpeed>
    </pawnFlyer>
  </ThingDef>
</Defs>

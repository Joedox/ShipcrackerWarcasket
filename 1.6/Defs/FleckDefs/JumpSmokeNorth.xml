<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!--
    VFEP's VFEP_JumpSmoke raised to PawnState, sprayed as fleckDefNorth by
    SubEffecter_ExhaustSprayer so the exhaust draws over the wearer's back while flying north;
    a fleck's altitude comes only from its def. A full copy because VFEP's def has no Name
    to inherit from; keep in step.
    Also used by the VGE root's purple effecters, which keep VFEP's smoke.
  -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>SCWC_JumpSmokeNorth</defName>
    <graphicData>
      <texPath>Things/Mote/Smoke</texPath>
    </graphicData>
    <altitudeLayer>PawnState</altitudeLayer>
    <solidTime>0.2</solidTime>
    <fadeOutTime>0.2</fadeOutTime>
    <growthRate>1.2</growthRate>
  </FleckDef>
</Defs>

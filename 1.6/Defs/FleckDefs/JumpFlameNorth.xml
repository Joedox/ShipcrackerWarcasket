<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!--
    VFEP's VFEP_JumpFlame raised to PawnState, sprayed as fleckDefNorth by
    SubEffecter_ExhaustSprayer so the exhaust draws over the wearer's back while flying north;
    a fleck's altitude comes only from its def. A full copy because VFEP's def has no Name
    to inherit from; keep in step.
  -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>SCWC_JumpFlameNorth</defName>
    <graphicData>
      <texPath>Things/Mote/VFEP_JumpFlame</texPath>
      <shaderType>TransparentPostLight</shaderType>
      <renderInstanced>true</renderInstanced>
    </graphicData>
    <altitudeLayer>PawnState</altitudeLayer>
    <solidTime>0.2</solidTime>
    <fadeOutTime>0.05</fadeOutTime>
    <growthRate>-4</growthRate>
  </FleckDef>
</Defs>

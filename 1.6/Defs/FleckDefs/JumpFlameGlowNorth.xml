<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!--
    VFEP's VFEP_JumpFlameGlow raised to PawnState, sprayed as fleckDefNorth by
    SubEffecter_ExhaustSprayer so the exhaust draws over the wearer's back while flying north;
    a fleck's altitude comes only from its def. A full copy because VFEP's def has no Name
    to inherit from; keep in step.
  -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>SCWC_JumpFlameGlowNorth</defName>
    <graphicData>
      <texPath>Things/Mote/VFEP_JumpFlame</texPath>
      <shaderType>MoteGlow</shaderType>
      <color>(1,0.6,0.6,0.3)</color>
    </graphicData>
    <altitudeLayer>PawnState</altitudeLayer>
    <solidTime>0</solidTime>
    <fadeOutTime>0.3</fadeOutTime>
    <growthRate>-3</growthRate>
  </FleckDef>
</Defs>

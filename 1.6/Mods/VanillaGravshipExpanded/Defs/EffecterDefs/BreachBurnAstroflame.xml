<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!--
    Space-flight exhaust under Vanilla Gravship Expanded: SCWC_BreachJumpAstroflame with the
    sprayers' maxMoteCount at 1000, as the main tree's SCWC_BreachBurnFlame. Set as the
    extension's spaceFlightEffecter by this root's BreachJumpAstrofuel.xml. Keep in step with
    the orange def.
  -->
  <EffecterDef>
    <defName>SCWC_BreachBurnAstroflame</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SoundTriggered</subEffecterClass>
        <spawnLocType>OnSource</spawnLocType>
        <soundDef>VFEP_JumpLaunch</soundDef>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <spawnLocType>OnSource</spawnLocType>
        <fleckDef>ShotFlash</fleckDef>
        <color>(0.75, 0.5, 1)</color>
        <scale>6</scale>
      </li>
      <li Class="ShipcrackerWarcasket.ExhaustSprayerDef">
        <subEffecterClass>ShipcrackerWarcasket.SubEffecter_ExhaustSprayer</subEffecterClass>
        <scale>0.5~0.6</scale>
        <spawnLocType>OnSource</spawnLocType>
        <positionOffset>(0,0,-0.05)</positionOffset>
        <fleckDef>SCWC_Astroflame</fleckDef>
        <fleckDefNorth>SCWC_AstroflameNorth</fleckDefNorth>
        <ticksBetweenMotes>1</ticksBetweenMotes>
        <maxMoteCount>1000</maxMoteCount>
        <speed>4~5</speed>
        <angle>170~190</angle>
        <absoluteAngle>true</absoluteAngle>
      </li>
      <li Class="ShipcrackerWarcasket.ExhaustSprayerDef">
        <subEffecterClass>ShipcrackerWarcasket.SubEffecter_ExhaustSprayer</subEffecterClass>
        <scale>0.9~0.7</scale>
        <spawnLocType>OnSource</spawnLocType>
        <positionOffset>(0,0,-0.05)</positionOffset>
        <fleckDef>SCWC_AstroflameGlow</fleckDef>
        <fleckDefNorth>SCWC_AstroflameGlowNorth</fleckDefNorth>
        <ticksBetweenMotes>1</ticksBetweenMotes>
        <maxMoteCount>1000</maxMoteCount>
        <speed>4~5</speed>
        <angle>160~200</angle>
        <absoluteAngle>true</absoluteAngle>
      </li>
      <li Class="ShipcrackerWarcasket.ExhaustSprayerDef">
        <subEffecterClass>ShipcrackerWarcasket.SubEffecter_ExhaustSprayer</subEffecterClass>
        <scale>0.8~1.2</scale>
        <spawnLocType>OnSource</spawnLocType>
        <positionOffset>(0,0,-0.05)</positionOffset>
        <fleckDef>VFEP_JumpSmoke</fleckDef>
        <fleckDefNorth>SCWC_JumpSmokeNorth</fleckDefNorth>
        <ticksBetweenMotes>2</ticksBetweenMotes>
        <maxMoteCount>1000</maxMoteCount>
        <speed>5~6</speed>
        <angle>170~190</angle>
        <absoluteAngle>true</absoluteAngle>
      </li>
    </children>
  </EffecterDef>
</Defs>

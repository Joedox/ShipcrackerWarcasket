<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!--
    Purple exhaust flame for the Breach Jump under Vanilla Gravship Expanded (VGE's astrofuel
    and astrofire art are purple). Mirrors VFEP's VFEP_JumpFlame (TransparentPostLight, solid
    0.2 s, fade 0.05 s, growth -4) on VGE's own Effects/Astrospark texture, referenced by path;
    this root only loads when VGE is present. A tint cannot do it on the orange texture (the
    mote shaders multiply, and orange has no blue to keep). Astrospark's blob fills about a
    third of its 128 px sheet (VFEP's fills its 64 px), so drawSize 3 matches VFEP's on-screen
    size at the same sprayer scales. Parent of SCWC_AstroflameNorth.
  -->
  <FleckDef Name="SCWC_Astroflame" ParentName="FleckBase_Thrown">
    <defName>SCWC_Astroflame</defName>
    <graphicData>
      <texPath>Effects/Astrospark</texPath>
      <shaderType>TransparentPostLight</shaderType>
      <renderInstanced>true</renderInstanced>
      <drawSize>(3, 3)</drawSize>
    </graphicData>
    <altitudeLayer>Projectile</altitudeLayer>
    <solidTime>0.2</solidTime>
    <fadeOutTime>0.05</fadeOutTime>
    <growthRate>-4</growthRate>
  </FleckDef>
</Defs>

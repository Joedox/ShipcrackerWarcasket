<?xml version="1.0" encoding="utf-8" ?>
<!--
  Built-in oxygen for the Shipcracker helmet under Vanilla Gravship Expanded. VacuumResistance.xml
  holds the set to VGE1's 0.97 so a suit alone never reaches immunity; this adds the comp
  VGE1's astrorig and oxygen packs use. While it holds oxygen and the wearer's base resistance
  is at least minResistanceToActivate, VGE1's StatPart_OxygenPack (which scans every worn
  apparel) forces VacuumResistance to 1.0. 50 charges, half the astrorig's: about 1.6 days of
  continuous vacuum at 1 charge per 2000 ticks, 1 oxygen canister per charge, auto-refill at a
  third like the astrorig.

  The comp needs tickerType Normal (VFEP_WarcasketPartBase sets Never). Our def declares no
  comps of its own, so the whole node is added and appends to the inherited list. The
  chargeNoun's DefInjected entry belongs in this root's Languages/, never the main tree.
-->
<Patch>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/VFEPirates.WarcasketDef[defName="SCWC_WarcasketHelmet_Shipcracker"]</xpath>
    <value>
      <tickerType>Normal</tickerType>
      <comps>
        <li Class="VanillaGravshipExpanded.CompProperties_ApparelOxygenProvider">
          <maxCharges>50</maxCharges>
          <percentageToAutoRefill>0.334</percentageToAutoRefill>
          <fuelDef>VGE_OxygenCanister</fuelDef>
          <fuelCountPerCharge>1</fuelCountPerCharge>
          <destroyOnEmpty>false</destroyOnEmpty>
          <chargeNoun>oxygen u³</chargeNoun>
          <minResistanceToActivate>0.12</minResistanceToActivate>
        </li>
      </comps>
    </value>
  </Operation>
</Patch>
